---
import ContactButton from '@components/ContactButton.astro';
import Header from '@components/Header.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../lib/schema';
import { thumb } from '../lib/images';

const projects = (await getCollection('projects')).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const categories = Array.from(new Set(projects.map((p) => p.data.category)));

const breadcrumb = breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Proyectos', path: '/projects/' },
]);
---

<Layout
    title="Proyectos de arquitectura y construcción en Colima | Arking"
    description={`Conoce ${projects.length} proyectos de casa habitación y espacio comercial construidos por Arking en Colima, México: superficie, acabados y galería de cada obra.`}
    schema={breadcrumb}
>
    <Header variant="solid" active="Obra" />

    <main>
        <!-- Encabezado -->
        <section class="bg-brand-paper pb-12 pt-16 lg:pb-16 lg:pt-24">
            <div class="mx-auto w-full max-w-[1560px] px-6 lg:px-20">
                <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
                    <div class="flex flex-col gap-5 lg:col-span-7" data-aos="fade-up">
                        <span class="label text-brand-slate">Obra</span>
                        <h1
                            class="font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.96] tracking-[-0.02em] text-brand-navy"
                        >
                            Nuestros<br /><em class="italic">proyectos</em>
                        </h1>
                    </div>
                    <div
                        class="flex flex-col gap-5 lg:col-span-5 lg:justify-end lg:pb-3"
                        data-aos="fade-up"
                    >
                        <p class="text-pretty text-[17px] leading-[1.75] text-brand-slate">
                            Transformamos ideas en espacios funcionales y estéticos, adaptados a las
                            necesidades de cada cliente. Estos son algunos de nuestros trabajos más
                            recientes, donde la planificación, el diseño y la ejecución se unen.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filtros -->
        <section class="border-t border-line bg-brand-paper">
            <div class="mx-auto w-full max-w-[1560px] px-6 lg:px-20">
                <div class="flex flex-wrap items-center gap-3 py-6 lg:py-8" data-aos="fade-up">
                    <span class="label mr-2 hidden text-brand-slate lg:inline">Filtrar</span>
                    <button
                        type="button"
                        class="filter-btn is-active"
                        data-category=""
                    >
                        Todos
                    </button>
                    {
                        categories.map((category) => (
                            <button type="button" class="filter-btn" data-category={category}>
                                {category}
                            </button>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Listado -->
        <section class="border-t border-line bg-brand-paper2 py-14 lg:py-20">
            <div class="mx-auto w-full max-w-[1560px] px-6 lg:px-20">
                <div
                    id="projects-list"
                    class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14"
                >
                    {
                        projects.map((project, index) => (
                            <a
                                href={`/projects/${project.slug}`}
                                class="group flex flex-col gap-4"
                                data-category={project.data.category}
                                data-aos="fade-up"
                            >
                                <div class="relative aspect-[4/3] overflow-hidden bg-[#dcd9d2]">
                                    <img
                                        alt={project.data.title}
                                        loading="lazy"
                                        width="800"
                                        height="600"
                                        decoding="async"
                                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                                        src={thumb(project.data.image)}
                                    />
                                    <span class="absolute left-0 top-5 inline-flex h-8 items-center bg-brand-navy px-4 text-[10px] uppercase tracking-label text-white">
                                        {project.data.specifications.status}
                                    </span>
                                </div>
                                <div class="flex items-start justify-between gap-4 border-t border-line pt-4">
                                    <div class="flex flex-col gap-1.5">
                                        <span class="font-display text-[26px] leading-none text-brand-navy">
                                            {project.data.title}
                                        </span>
                                        <span class="text-xs tracking-[0.1em] text-brand-slate">
                                            {project.data.category} ·{' '}
                                            {project.data.specifications.area} ·{' '}
                                            {project.data.specifications.year}
                                        </span>
                                    </div>
                                    <span class="pt-1 font-display text-lg text-brand-navy/40">
                                        {String(index + 1).padStart(2, '0')}
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>

                <p id="projects-empty" class="hidden py-16 text-center text-brand-slate">
                    No hay proyectos en esta categoría por ahora.
                </p>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-brand-navy py-20 text-white lg:py-28" data-aos="fade-up">
            <div class="mx-auto w-full max-w-[1560px] px-6 text-center lg:px-20">
                <div class="mx-auto flex max-w-3xl flex-col items-center gap-7">
                    <h2
                        class="text-pretty font-display text-[clamp(2.5rem,5.5vw,4rem)] leading-[1.02] tracking-[-0.02em]"
                    >
                        ¿No encuentras lo que<br /><em class="italic">buscas?</em>
                    </h2>
                    <p class="text-pretty text-[17px] leading-[1.7] text-white/[0.72] lg:text-lg">
                        Cada proyecto es único. Hablemos sobre cómo podemos crear algo especial para
                        ti.
                    </p>
                    <ContactButton variant="light" class="mt-2" />
                </div>
            </div>
        </section>
    </main>
</Layout>

<style is:global>
    .filter-btn {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 1.25rem;
        border: 1px solid rgba(0, 36, 77, 0.16);
        background: transparent;
        color: #3d5978;
        font-size: 13px;
        letter-spacing: 0.06em;
        cursor: pointer;
        transition:
            background-color 0.25s ease,
            border-color 0.25s ease,
            color 0.25s ease;
    }
    .filter-btn:hover {
        border-color: #00244d;
        color: #00244d;
    }
    .filter-btn.is-active {
        background: #00244d;
        border-color: #00244d;
        color: #ffffff;
    }
</style>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('#projects-list > a');
    const empty = document.getElementById('projects-empty');

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            const category = button.dataset.category ?? '';
            let visible = 0;

            cards.forEach((card) => {
                const matches = !category || card.dataset.category === category;
                card.style.display = matches ? '' : 'none';
                if (matches) visible += 1;
            });

            buttons.forEach((other) => other.classList.toggle('is-active', other === button));
            empty?.classList.toggle('hidden', visible > 0);
        });
    });
</script>
