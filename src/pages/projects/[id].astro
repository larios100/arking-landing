---
import ProjectDetail from '@components/ProjectDetail.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, projectSchema } from '../../lib/schema';
import { excerpt } from '../../lib/seo';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const projectEntries = await getCollection('projects');
    return projectEntries.map((entry) => {
        return {
            params: { id: entry.slug },
            props: { entry },
        };
    });
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { title, category, specifications } = entry.data;

const summary = excerpt(entry.body, 110);
const description =
    `${category} de ${specifications.construction} en ${specifications.location}` +
    (summary ? `. ${summary}` : '. Proyecto de Arking, diseño y construcción.');

const schema = [
    breadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Proyectos', path: '/projects/' },
        { name: title, path: `/projects/${entry.slug}/` },
    ]),
    projectSchema(entry.data, entry.slug, description),
];
---

<Layout
    title={`${title} — ${category} en ${specifications.location.split(',')[0]} | Arking`}
    description={description}
    image={`/img/og/${entry.slug}.jpg`}
    type="article"
    schema={schema}
>
    <ProjectDetail entry={entry} />
</Layout>
