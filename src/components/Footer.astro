---
import { BUSINESS } from '../consts';

const services = ['Arquitectura', 'Construcción', 'Diseño', 'Urbanización'];
const navigation = [
    { title: 'Estudio', href: '/#About' },
    { title: 'Obra', href: '/#Projects' },
    { title: 'Clientes', href: '/#Customers' },
    { title: 'Contacto', href: '/#Contact' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-brand-ink px-6 pb-11 pt-16 text-white lg:px-20 lg:pt-[90px]">
    <div class="mx-auto w-full max-w-[1560px]">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-12">
            <div class="flex flex-col gap-6 lg:col-span-5">
                <img
                    src="/img/logo-blanco.png"
                    alt="Arking"
                    width="506"
                    height="422"
                    loading="lazy"
                    class="h-[52px] w-auto self-start opacity-95"
                />
                <p class="max-w-[380px] text-pretty text-[15px] leading-[1.7] text-white/60">
                    Arquitectos y constructores en Colima, México. Diseño y construcción de casa
                    habitación y espacio comercial.
                </p>
                <div class="flex gap-3">
                    <a
                        href="https://www.instagram.com/arking.construccion"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram de Arking"
                        class="flex h-11 w-11 items-center justify-center border border-white/20 text-white transition-colors hover:border-white hover:bg-white/10"
                    >
                        <svg
                            width="17"
                            height="17"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="20" height="20" x="2" y="2" rx="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"></path>
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                        </svg>
                    </a>
                    <a
                        href="https://www.facebook.com/profile.php?id=61573052413049"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook de Arking"
                        class="flex h-11 w-11 items-center justify-center border border-white/20 text-white transition-colors hover:border-white hover:bg-white/10"
                    >
                        <svg
                            width="17"
                            height="17"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="flex flex-col gap-[18px] lg:col-span-2">
                <h4 class="label text-white/50">Servicios</h4>
                <ul class="flex flex-col gap-3">
                    {services.map((service) => <li class="text-[15px] text-white/[0.82]">{service}</li>)}
                </ul>
            </div>

            <div class="flex flex-col gap-[18px] lg:col-span-2">
                <h4 class="label text-white/50">Navegación</h4>
                <ul class="flex flex-col gap-3">
                    {
                        navigation.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="text-[15px] text-white/[0.82] transition-colors hover:text-white"
                                >
                                    {item.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="flex flex-col gap-[18px] lg:col-span-3">
                <h4 class="label text-white/50">Oficina</h4>
                <p class="text-[15px] leading-[1.7] text-white/[0.82]">
                    {BUSINESS.street}<br />{BUSINESS.neighborhood}<br />CP {BUSINESS.postalCode} ·{
                        ' '
                    }{BUSINESS.city}, México
                </p>
                <a
                    href={`tel:${BUSINESS.phoneE164}`}
                    class="text-[15px] text-white/[0.82] transition-colors hover:text-white"
                >
                    {BUSINESS.phone}
                </a>
                <a
                    href={`mailto:${BUSINESS.email}`}
                    class="text-[15px] text-white/[0.82] transition-colors hover:text-white"
                >
                    {BUSINESS.email}
                </a>
                <span class="text-[15px] leading-[1.7] text-white/50">{BUSINESS.hours}</span>
            </div>
        </div>

        <div
            class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-7 sm:flex-row sm:items-center sm:justify-between lg:mt-[70px]"
        >
            <span class="text-xs text-white/40">
                © {year} Arking. Todos los derechos reservados.
            </span>
            <span class="text-xs uppercase tracking-wider2 text-white/40">Colima · México</span>
        </div>
    </div>
</footer>
