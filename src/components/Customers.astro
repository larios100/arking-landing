---
const clients = [
    { src: '/img/clients/1.jpg', alt: 'Cliente de Arking' },
    { src: '/img/clients/2.png', alt: 'Cliente de Arking' },
    { src: '/img/clients/3.png', alt: 'Cliente de Arking' },
    { src: '/img/clients/4.png', alt: 'Cliente de Arking' },
];
---

<section id="Customers" class="scroll-mt-24 border-t border-line bg-brand-paper py-16 lg:py-[110px]">
    <div class="mx-auto w-full max-w-[1560px] px-6 lg:px-20">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="flex flex-col gap-4 lg:col-span-3" data-aos="fade-up">
                <span class="label text-brand-slate">03 — Confianza</span>
                <p class="text-pretty text-[17px] leading-relaxed text-brand-navy">
                    Empresas e instituciones que han construido con nosotros.
                </p>
            </div>

            <div
                class="grid grid-cols-2 border-r border-line lg:col-span-9 lg:grid-cols-4"
                data-aos="fade-up"
            >
                {
                    clients.map((client) => (
                        <div
                            class="flex h-[104px] items-center justify-center border-l border-line px-6 lg:h-[118px] lg:px-8"
                        >
                            <img
                                src={client.src}
                                alt={client.alt}
                                width="320"
                                height="160"
                                loading="lazy"
                                decoding="async"
                                class="max-h-[52px] w-auto max-w-full object-contain opacity-60 grayscale transition duration-500 hover:opacity-100 hover:grayscale-0 lg:max-h-[62px]"
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
