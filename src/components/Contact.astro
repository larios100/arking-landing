---
import ContactButton from './ContactButton.astro';
import { BUSINESS } from '../consts';

const details = [
    { label: 'Teléfono', value: BUSINESS.phone, href: `tel:${BUSINESS.phoneE164}` },
    { label: 'Correo', value: BUSINESS.email, href: `mailto:${BUSINESS.email}` },
    {
        label: 'Oficina',
        value: `${BUSINESS.street}\n${BUSINESS.neighborhood}, CP ${BUSINESS.postalCode}\n${BUSINESS.city}, México`,
    },
    { label: 'Horario', value: BUSINESS.hours },
];
---

<section id="Contact" class="scroll-mt-24 bg-brand-navy py-20 text-white lg:py-[150px]">
    <div class="mx-auto w-full max-w-[1560px] px-6 lg:px-20">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
            <div class="flex flex-col gap-7 lg:col-span-7 lg:gap-[34px]" data-aos="fade-up">
                <div class="flex items-center gap-3 lg:gap-[14px]">
                    <span class="h-px w-7 bg-brand-blue lg:w-9"></span>
                    <span class="label text-white/70">04 — Contacto</span>
                </div>

                <h2
                    class="text-pretty font-display text-[clamp(2.75rem,6.5vw,5.25rem)] leading-[0.98] tracking-[-0.02em]"
                >
                    Construyamos tu<br /><em class="italic">visión juntos</em>
                </h2>

                <p class="max-w-[500px] text-pretty text-[17px] leading-[1.7] text-white/[0.72] lg:text-lg">
                    Cuéntanos qué tienes en mente —obra nueva, remodelación o un terreno por
                    desarrollar en Colima— y agendamos una visita.
                </p>

                <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:gap-6 lg:pt-3">
                    <ContactButton variant="light" />
                    <a href={`tel:${BUSINESS.phoneE164}`} class="btn btn-outline-light">
                        {BUSINESS.phone}
                    </a>
                </div>
            </div>

            <div class="flex flex-col lg:col-span-5 lg:mt-3" data-aos="fade-up">
                {
                    details.map((detail, index) => (
                        <div
                            class:list={[
                                'flex flex-col gap-2.5 border-t border-line-light py-6',
                                index === details.length - 1 && 'border-b',
                            ]}
                        >
                            <span class="label text-white/50">{detail.label}</span>
                            {detail.href ? (
                                <a
                                    href={detail.href}
                                    class="whitespace-pre-line text-[17px] leading-[1.55] text-white transition-colors hover:text-white/70"
                                >
                                    {detail.value}
                                </a>
                            ) : (
                                <span class="whitespace-pre-line text-[17px] leading-[1.55] text-white">
                                    {detail.value}
                                </span>
                            )}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
