---
import { getCollection } from 'astro:content';
import ContactButton from './ContactButton.astro';
import Header from './Header.astro';
import { thumb } from '../lib/images';

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, image, price, category, specifications, images, features, address, location } =
    entry.data;
const { lat, lng } = location;

const projects = (await getCollection('projects')).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const index = projects.findIndex((p) => p.slug === entry.slug);
const position = String(index + 1).padStart(2, '0');
const next = projects[(index + 1) % projects.length];

// Las recámaras solo aplican a vivienda: un local no las tiene.
const isResidential = /casa|habitaci/i.test(category);

const specs = [
    { label: 'Terreno', value: specifications.area },
    { label: 'Construcción', value: specifications.construction },
    { label: 'Niveles', value: specifications.floors },
    ...(isResidential
        ? [
              { label: 'Recámaras', value: specifications.bedrooms },
              { label: 'Baños', value: specifications.bathrooms },
          ]
        : []),
    {
        label: 'Estacionamiento',
        value: `${specifications.parking} ${Number(specifications.parking) === 1 ? 'auto' : 'autos'}`,
    },
    { label: 'Tipo', value: specifications.type },
];

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
const whatsappMessage = `Hola, me interesa el proyecto ${title}. ¿Podemos agendar una visita?`;
---

<link
    href="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/css/glightbox.min.css"
    rel="stylesheet"
/>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />

<Header variant="solid" active="Obra" />

<main class="bg-brand-paper">
    <!-- Título -->
    <section class="px-6 pb-10 pt-10 lg:px-20 lg:pb-12 lg:pt-[66px]">
        <div class="mx-auto w-full max-w-[1560px]">
            <a
                href="/projects"
                class="mb-8 inline-flex items-center gap-2.5 text-xs uppercase tracking-wider2 text-brand-slate transition-colors hover:text-brand-navy lg:mb-11"
            >
                <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path>
                </svg>
                <span>Volver a la obra</span>
            </a>

            <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-14">
                <div class="flex flex-col gap-4 lg:gap-5" data-aos="fade-up">
                    <div class="flex items-center gap-3 lg:gap-[14px]">
                        <span class="font-display text-xl text-brand-blue">{position}</span>
                        <span class="h-px w-[30px] bg-brand-navy/25"></span>
                        <span class="label text-brand-slate">{category}</span>
                    </div>
                    <h1
                        class="font-display text-[clamp(3rem,8vw,6.5rem)] leading-[0.94] tracking-[-0.025em] text-brand-navy"
                    >
                        {title}
                    </h1>
                </div>

                <div class="flex flex-wrap gap-y-5 lg:pb-3.5" data-aos="fade-up">
                    <div class="flex flex-col gap-2 border-l border-line pl-6 pr-6 lg:pl-7 lg:pr-7">
                        <span class="label text-brand-slate">Ubicación</span>
                        <span class="text-base text-brand-navy">{specifications.location}</span>
                    </div>
                    <div class="flex flex-col gap-2 border-l border-line pl-6 pr-6 lg:pl-7 lg:pr-7">
                        <span class="label text-brand-slate">Año</span>
                        <span class="text-base text-brand-navy">{specifications.year}</span>
                    </div>
                    <div class="flex flex-col gap-2 border-l border-line pl-6 lg:pl-7">
                        <span class="label text-brand-slate">Estado</span>
                        <span class="text-base text-brand-blue">{specifications.status}</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Imagen principal -->
    <section class="px-6 lg:px-20">
        <div class="mx-auto w-full max-w-[1560px]" data-aos="fade-up">
            <div class="h-[280px] w-full overflow-hidden bg-[#dcd9d2] sm:h-[420px] lg:h-[660px]">
                <img
                    alt={`${title} — fachada principal`}
                    width="1600"
                    height="900"
                    fetchpriority="high"
                    decoding="async"
                    class="h-full w-full object-cover"
                    src={image}
                />
            </div>
            <div class="flex items-center justify-between pt-3.5">
                <span class="label text-brand-slate">Fachada principal</span>
                <span class="label text-brand-navy/45">
                    01 / {String(images.length).padStart(2, '0')}
                </span>
            </div>
        </div>
    </section>

    <!-- Descripción y ficha -->
    <section class="px-6 py-16 lg:px-20 lg:py-[110px]">
        <div class="mx-auto grid w-full max-w-[1560px] grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="flex flex-col gap-7 lg:col-span-7" data-aos="fade-up">
                <div class="prose-arking text-pretty text-[17px] leading-[1.78] text-brand-slate">
                    <Content />
                </div>

                {
                    features.length > 0 && (
                        <div class="mt-4 flex flex-col gap-5 lg:mt-[22px]">
                            <span class="label text-brand-slate">Incluye</span>
                            <div class="flex flex-wrap gap-2.5">
                                {features.map((feature: string) => (
                                    <span class="inline-flex h-10 items-center border border-line px-[18px] text-sm text-brand-navy">
                                        {feature}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )
                }
            </div>

            <aside class="lg:col-span-5" data-aos="fade-up">
                <div class="flex flex-col border border-line bg-white p-7 lg:sticky lg:top-28 lg:p-10">
                    <!-- <div class="flex flex-col gap-2 border-b border-line pb-6">
                        <span class="label text-brand-slate">Precio</span>
                        <span class="font-display text-4xl leading-none text-brand-navy lg:text-[42px]">
                            {price}
                            <span class="ml-1 font-sans text-[15px] tracking-[0.1em] text-brand-slate">
                                MXN
                            </span>
                        </span>
                    </div>-->

                    {
                        specs.map((spec, i) => (
                            <div
                                class:list={[
                                    'flex items-baseline justify-between py-[15px]',
                                    i < specs.length - 1
                                        ? 'border-b border-line-soft'
                                        : 'pb-6',
                                ]}
                            >
                                <span class="text-[13px] tracking-[0.06em] text-brand-slate">
                                    {spec.label}
                                </span>
                                <span class="text-[15px] text-brand-navy">{spec.value}</span>
                            </div>
                        ))
                    }

                    <ContactButton
                        variant="solid"
                        label="Agendar una visita"
                        message={whatsappMessage}
                        class="w-full"
                    />
                    <a href="tel:+523124055805" class="btn btn-outline mt-2.5 !h-[52px] w-full">
                        Llamar +52 312 405 58 05
                    </a>
                </div>
            </aside>
        </div>
    </section>

    <!-- Galería -->
    {
        images.length > 0 && (
            <section class="px-6 pb-16 lg:px-20 lg:pb-[100px]">
                <div class="mx-auto w-full max-w-[1560px]" data-aos="fade-up">
                    <div class="mb-8 flex items-end justify-between border-b border-line pb-6 lg:mb-8 lg:pb-8">
                        <h2 class="font-display text-3xl leading-none text-brand-navy lg:text-[40px]">
                            Galería
                        </h2>
                        <span class="label text-brand-slate">
                            {images.length} {images.length === 1 ? 'imagen' : 'imágenes'}
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                        {images.map((photo: string, i: number) => (
                            <a
                                href={photo}
                                class:list={[
                                    'glightbox group block h-[260px] overflow-hidden bg-[#dcd9d2] sm:h-[340px] lg:h-[460px]',
                                    i % 3 === 0 ? 'sm:col-span-2' : 'sm:col-span-1',
                                ]}
                            >
                                <img
                                    alt={`${title} — foto ${i + 1}`}
                                    loading="lazy"
                                    width="1200"
                                    height="800"
                                    decoding="async"
                                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                                    src={thumb(photo)}
                                />
                            </a>
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- Ubicación -->
    <section class="px-6 pb-16 lg:px-20 lg:pb-[110px]">
        <div
            class="mx-auto grid w-full max-w-[1560px] grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-12"
            data-aos="fade-up"
        >
            <div class="flex flex-col justify-center gap-5 lg:col-span-4">
                <span class="label text-brand-slate">Ubicación</span>
                <h2 class="font-display text-3xl leading-[1.06] text-brand-navy lg:text-[40px]">
                    {specifications.location}
                </h2>
                <p class="text-base leading-[1.7] text-brand-slate">{address}</p>
                <span class="text-xs tracking-[0.14em] text-brand-navy/50">
                    {lat.toFixed(4)}° N · {Math.abs(lng).toFixed(4)}° O
                </span>
                <a
                    href={mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-rule mt-2 self-start"
                >
                    <span>Abrir en Google Maps</span>
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#1a75cf"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M7 17 17 7"></path><path d="M7 7h10v10"></path>
                    </svg>
                </a>
            </div>

            <div class="border border-line lg:col-span-8">
                <div
                    id="map"
                    data-lat={lat}
                    data-lng={lng}
                    data-title={title}
                    class="h-[300px] w-full lg:h-[340px]"
                >
                </div>
            </div>
        </div>
    </section>

    <!-- Siguiente proyecto -->
    <section class="bg-brand-navy text-white">
        <a
            href={`/projects/${next.slug}`}
            class="group mx-auto flex w-full max-w-[1560px] flex-col gap-8 px-6 py-14 sm:flex-row sm:items-center sm:justify-between lg:gap-10 lg:px-20 lg:py-[74px]"
        >
            <div class="flex flex-col gap-3 lg:gap-3.5">
                <span class="label text-white/60">Siguiente proyecto</span>
                <span
                    class="font-display text-[clamp(2.5rem,5vw,3.875rem)] leading-none text-white"
                >
                    {next.data.title}
                </span>
            </div>
            <div class="flex items-center gap-6 lg:gap-8">
                <div class="h-[100px] w-[150px] overflow-hidden bg-[#123a63] lg:h-[130px] lg:w-[190px]">
                    <img
                        src={thumb(next.data.image)}
                        alt={next.data.title}
                        width="400"
                        height="300"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                </div>
                <svg
                    width="34"
                    height="34"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="shrink-0 transition-transform duration-500 group-hover:translate-x-2"
                >
                    <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
                </svg>
            </div>
        </a>
    </section>
</main>

<style is:global>
    .prose-arking > * + * {
        margin-top: 1.5rem;
    }
    .prose-arking h1,
    .prose-arking h2,
    .prose-arking h3 {
        font-family: 'Instrument Serif', 'Times New Roman', Georgia, serif;
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.015em;
        color: #00244d;
    }
    .prose-arking h1 {
        font-size: 2.75rem;
    }
    .prose-arking h2 {
        font-size: 2.25rem;
    }
    .prose-arking h3 {
        font-size: 1.75rem;
    }
    .prose-arking ul {
        list-style: none;
        padding: 0;
    }
    .prose-arking li {
        padding: 0.75rem 0;
        border-top: 1px solid rgba(0, 36, 77, 0.09);
    }
    .prose-arking strong {
        font-weight: 500;
        color: #00244d;
    }

    /* Mapa: sin esquinas redondeadas, en la paleta del sitio */
    .leaflet-container {
        font-family: Archivo, 'Helvetica Neue', Helvetica, sans-serif;
    }
</style>

<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/js/glightbox.min.js" defer></script>
<script is:inline>
    window.addEventListener('load', () => {
        if (typeof GLightbox !== 'undefined') {
            GLightbox({ selector: '.glightbox' });
        }

        const mapa = document.getElementById('map');
        if (!mapa || typeof L === 'undefined') return;

        const lat = parseFloat(mapa.dataset.lat);
        const lng = parseFloat(mapa.dataset.lng);
        const map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
        }).addTo(map);

        L.marker([lat, lng]).addTo(map).bindPopup(mapa.dataset.title).openPopup();
    });
</script>
