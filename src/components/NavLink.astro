---
interface Props {
    title: string;
    href: string;
    variant?: 'light' | 'dark';
    active?: boolean;
    class?: string;
}

const { title, href, variant = 'dark', active = false, class: className = '' } = Astro.props;

const base = 'pb-[3px] text-[13px] tracking-[0.04em] transition-colors';
const tone =
    variant === 'light'
        ? active
            ? 'text-white border-b border-brand-blue'
            : 'text-white/[0.78] hover:text-white'
        : active
          ? 'text-brand-navy border-b border-brand-blue'
          : 'text-brand-slate hover:text-brand-navy';
---

<a class={`${base} ${tone} ${className}`} href={href}>{title}</a>
