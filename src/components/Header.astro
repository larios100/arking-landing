---
import NavLink from './NavLink.astro';

interface Props {
    /** overlay: sobre el hero oscuro · solid: barra de papel en páginas interiores */
    variant?: 'overlay' | 'solid';
    active?: string;
}

const { variant = 'solid', active = '' } = Astro.props;
const isOverlay = variant === 'overlay';

const links = [
    { title: 'Estudio', href: '/#About' },
    { title: 'Obra', href: '/#Projects' },
    { title: 'Clientes', href: '/#Customers' },
    { title: 'Contacto', href: '/#Contact' },
];

const wrapperClass = isOverlay
    ? 'site-header fixed top-0 left-0 right-0 z-40 border-b border-white/[0.14] transition-colors duration-300'
    : 'sticky top-0 z-40 border-b border-line bg-brand-paper/95 backdrop-blur';
---

<header class={wrapperClass}>
    <div
        class="mx-auto flex w-full max-w-[1560px] items-center justify-between px-6 py-5 lg:px-20 lg:py-[26px]"
    >
        <a href="/" class="flex items-center gap-3" aria-label="Arking — inicio">
            {
                isOverlay ? (
                    <>
                        <span class="h-[22px] w-[3px] bg-brand-blue" />
                        <span class="hdr-word text-[17px] font-semibold tracking-[0.30em] text-white">
                            ARKING
                        </span>
                    </>
                ) : (
                    <img
                        src="/img/logo-horizontal.png"
                        alt="Arking"
                        width="520"
                        height="134"
                        class="h-[26px] w-auto lg:h-[30px]"
                    />
                )
            }
        </a>

        <!-- Navegación de escritorio -->
        <nav class="hidden items-center gap-9 lg:flex">
            {
                links.map((link) => (
                    <NavLink
                        title={link.title}
                        href={link.href}
                        variant={isOverlay ? 'light' : 'dark'}
                        active={active === link.title}
                        class={isOverlay ? 'hdr-link' : ''}
                    />
                ))
            }
            <a
                href="https://wa.me/5213124055805?text=Hola%2C%20vengo%20de%20su%20sitio%20web%20y%20me%20interesa%20saber%20m%C3%A1s%20sobre%20sus%20servicios"
                target="_blank"
                rel="noopener noreferrer"
                class={`btn !h-11 !px-[22px] ${isOverlay ? 'hdr-cta btn-outline-light' : 'btn-solid'}`}
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.05-1.32A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3 .78.8-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2Zm4.5-6.13c-.25-.13-1.46-.72-1.68-.8-.23-.09-.39-.13-.55.12-.16.25-.63.8-.78.96-.14.17-.28.19-.53.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.16.04-.3-.02-.42-.06-.13-.55-1.33-.76-1.82-.2-.47-.4-.4-.55-.41h-.47a.9.9 0 0 0-.65.3c-.22.25-.85.83-.85 2.02s.87 2.34.99 2.5c.12.17 1.71 2.62 4.15 3.67 1.55.67 2.15.73 2.92.61.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.11-.23-.17-.48-.3Z"
                    ></path>
                </svg>
                <span>312 405 58 05</span>
            </a>
        </nav>

        <!-- Botón de menú móvil -->
        <button
            id="menu-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class={`-mr-3 flex h-11 w-11 items-center justify-center lg:hidden ${
                isOverlay ? 'hdr-burger text-white' : 'text-brand-navy'
            }`}
        >
            <svg
                id="menu-icon-open"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
            >
                <path d="M3 7h18"></path><path d="M3 12h18"></path><path d="M3 17h18"></path>
            </svg>
            <svg
                id="menu-icon-close"
                class="hidden"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
            >
                <path d="M6 18 18 6"></path><path d="m6 6 12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Panel móvil -->
    <nav
        id="mobile-menu"
        class="hidden border-t border-line-light bg-brand-navy px-6 pb-8 pt-2 lg:hidden"
    >
        <ul class="flex flex-col">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="flex h-14 items-center border-b border-white/[0.14] font-display text-2xl text-white"
                        >
                            {link.title}
                        </a>
                    </li>
                ))
            }
        </ul>
        <a
            href="https://wa.me/5213124055805?text=Hola%2C%20vengo%20de%20su%20sitio%20web%20y%20me%20interesa%20saber%20m%C3%A1s%20sobre%20sus%20servicios"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-light mt-6 w-full"
        >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                    d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.05-1.32A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3 .78.8-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2Zm4.5-6.13c-.25-.13-1.46-.72-1.68-.8-.23-.09-.39-.13-.55.12-.16.25-.63.8-.78.96-.14.17-.28.19-.53.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.16.04-.3-.02-.42-.06-.13-.55-1.33-.76-1.82-.2-.47-.4-.4-.55-.41h-.47a.9.9 0 0 0-.65.3c-.22.25-.85.83-.85 2.02s.87 2.34.99 2.5c.12.17 1.71 2.62 4.15 3.67 1.55.67 2.15.73 2.92.61.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.11-.23-.17-.48-.3Z"
                ></path>
            </svg>
            <span>Escríbenos por WhatsApp</span>
        </a>
    </nav>
</header>

<style is:global>
    .site-header.is-stuck {
        background: rgba(246, 245, 242, 0.96);
        backdrop-filter: blur(8px);
        border-bottom-color: rgba(0, 36, 77, 0.14);
    }
    .site-header.is-stuck .hdr-word,
    .site-header.is-stuck .hdr-burger {
        color: #00244d;
    }
    .site-header.is-stuck .hdr-link {
        color: #3d5978;
    }
    .site-header.is-stuck .hdr-link:hover {
        color: #00244d;
    }
    .site-header.is-stuck .hdr-cta {
        border-color: rgba(0, 36, 77, 0.22);
        color: #00244d;
    }
    .site-header.is-stuck .hdr-cta:hover {
        border-color: #00244d;
        background: rgba(0, 36, 77, 0.04);
    }
</style>

<script>
    const stickyHeader = document.querySelector('.site-header');
    const hero = document.getElementById('Home');

    if (stickyHeader && hero) {
        const observer = new IntersectionObserver(
            ([entry]) => stickyHeader.classList.toggle('is-stuck', !entry.isIntersecting),
            { rootMargin: '-90px 0px 0px 0px', threshold: 0 }
        );
        observer.observe(hero);
    }

    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    function setMenu(open: boolean) {
        if (!toggle || !menu || !iconOpen || !iconClose) return;
        menu.classList.toggle('hidden', !open);
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    }

    toggle?.addEventListener('click', () => {
        setMenu(menu?.classList.contains('hidden') ?? false);
    });

    menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
    });
</script>
